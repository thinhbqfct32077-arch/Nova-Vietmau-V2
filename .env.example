# GEMINI_API_KEY: Required for Nova AI (Gemini API calls).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Secret key used by Express server for signing HMAC-SHA256 user sessions.
# Generate a strong random 32+ char string in production. Never expose to frontend!
SESSION_SECRET="CHANGE_ME_TO_STRONG_RANDOM_SECRET"

# APP_URL: Public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPTIONAL EXTERNAL STORAGE / DATABASE (Required when deploying to stateless serverless hosts like Vercel)
# DATABASE_URL="postgres://..."
# OBJECT_STORAGE_BUCKET=""

# OPTIONAL REAL PAYMENT GATEWAY (Only enable card/wallet gateways when real merchant keys are configured)
# PAYMENT_GATEWAY_PROVIDER=""
# PAYMENT_GATEWAY_SECRET_KEY=""
